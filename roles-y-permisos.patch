   const expired = !!data.expires_at && new Date(data.expires_at).getTime() <= Date.now()
+  const role = normalizeRole(data.role)
   return {
     isMember: !expired,
-    isAdmin: data.role === 'admin' && !expired,
+    isAdmin: role === 'admin' && !expired,
+    role: expired ? null : role,
     expired,
